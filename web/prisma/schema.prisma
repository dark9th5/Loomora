generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID_MANUALLY
  PAID
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ReleaseChannel {
  INTERNAL
  BETA
  STABLE
}

enum ReleaseStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model User {
  id              String   @id @default(cuid())
  name            String?
  email           String?  @unique
  normalizedEmail String?  @unique
  emailVerified   DateTime?
  image           String?
  role            Role     @default(CUSTOMER)
  disabledAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  customerProfile CustomerProfile?
  orders          Order[]
  licenses        License[]
  supportTickets  SupportTicket[]
  auditLogs       AuditLog[] @relation("AuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  company   String?
  phone     String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  editions    Edition[]
  createdAt   DateTime  @default(now())
}

model Edition {
  id           String              @id @default(cuid())
  productId    String
  slug         String
  name         String
  priceCents   Int
  currency     String              @default("USD")
  product      Product             @relation(fields: [productId], references: [id])
  capabilities EditionCapability[]
  orderItems   OrderItem[]
  licenses     License[]

  @@unique([productId, slug])
}

model Capability {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String
  editions    EditionCapability[]
  licenses    LicenseCapability[]
}

model EditionCapability {
  editionId    String
  capabilityId String
  edition      Edition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([editionId, capabilityId])
}

model License {
  id              String              @id @default(cuid())
  customerUserId  String
  editionId       String
  status          String
  currentRevision Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  customer        User                @relation(fields: [customerUserId], references: [id])
  edition         Edition             @relation(fields: [editionId], references: [id])
  revisions       LicenseRevision[]
  capabilities    LicenseCapability[]
  deviceBinding   DeviceBinding?
}

model LicenseRevision {
  id            String   @id @default(cuid())
  licenseId     String
  revision       Int
  payloadJson    Json
  signature      String
  keyId          String
  payloadHash    String
  actorUserId    String
  createdAt      DateTime @default(now())
  license        License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, revision])
}

model LicenseCapability {
  licenseId    String
  capabilityId String
  license      License    @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@id([licenseId, capabilityId])
}

model DeviceBinding {
  id        String   @id @default(cuid())
  licenseId String   @unique
  label     String?
  digest    String
  createdAt DateTime @default(now())
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
}

model Order {
  id             String          @id @default(cuid())
  customerUserId String
  status         OrderStatus     @default(DRAFT)
  currency       String          @default("USD")
  totalCents     Int             @default(0)
  adminNote      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       User            @relation(fields: [customerUserId], references: [id])
  items          OrderItem[]
  payments       PaymentRecord[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  editionId String
  quantity  Int     @default(1)
  unitCents Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  edition   Edition @relation(fields: [editionId], references: [id])
}

model PaymentRecord {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  provider    String
  reference   String?
  amountCents Int
  reason      String
  actorUserId String
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AppRelease {
  id                 String             @id @default(cuid())
  versionName        String
  versionCode        Int
  channel            ReleaseChannel
  status             ReleaseStatus      @default(DRAFT)
  releaseNotes       String
  minimumAndroid     String
  supportedAbis      String
  checksumSha256     String
  fileSizeBytes      BigInt
  artifactStorageRef String
  publishedAt        DateTime?
  downloads          DownloadArtifact[]
  createdAt          DateTime           @default(now())
}

model DownloadArtifact {
  id           String     @id @default(cuid())
  releaseId    String
  fileName     String
  contentType  String
  sizeBytes    BigInt
  checksumSha256 String
  storageRef   String
  public       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  release      AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id             String           @id @default(cuid())
  customerUserId String?
  email          String
  topic          String
  subject        String
  status         TicketStatus     @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customer       User?            @relation(fields: [customerUserId], references: [id])
  messages       SupportMessage[]
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  authorUserId String?
  body        String
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  topic     String
  message   String
  consent   Boolean
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  status      String
  authorUserId String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
